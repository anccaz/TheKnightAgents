{
  "name": "breach-room-module",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "publish:cloud": "spacetime publish --server maincloud breach-room",
    "publish:local": "spacetime publish --server http://127.0.0.1:3010 -y breach-room",
    "generate": "spacetime generate --lang typescript --module-path . -y --out-dir ../client/src/module_bindings"
  },
  "dependencies": {
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
